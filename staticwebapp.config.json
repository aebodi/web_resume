{
	"routes": [
		{
			"route": "/resume.pdf",
			"redirect": "/andres-bodington-resume.pdf",
			"statusCode": 301
		}
	],
	"navigationFallback": {
		"rewrite": "/index.html"
	},
	"mimeTypes": {
		".pdf": "application/pdf",
		".css": "text/css",
		".html": "text/html"
	},
	"globalHeaders": {
		"Strict-Transport-Security": "max-age=31536000; includeSubDomains"
	}
}
